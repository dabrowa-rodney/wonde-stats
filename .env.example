# Copy to .env.local for local development, and set the same variables in
# Vercel → Project → Settings → Environment Variables for deployment.

# The shared password everyone types on the login page.
DASHBOARD_PASSWORD=change-me

# Secret used to sign the session cookie. Must be at least 32 characters.
# Generate one with:  npm run gen-secret
SESSION_SECRET=

# Optional. How long a login lasts, in hours. Defaults to 12.
# SESSION_TTL_HOURS=12
